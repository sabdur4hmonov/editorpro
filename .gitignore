# Videolar, oraliq fayllar va virtual muhit gitga kirmaydi
samples/*
input/*
output/*
temp/*
!samples/.gitkeep
!input/.gitkeep
!output/.gitkeep
!temp/.gitkeep
.venv/
jobs/
*.mp4
*.mov
*.mkv
*.wav
!assets/sfx/*.wav
!assets/sfx/**/*.wav
!brands/**/sfx/*.wav
__pycache__/
*.pyc
# Maxfiy kalitlar (stok rasm va AI rasm xizmatlari)
.env
# Chatdan yuborilgan fayllar (Claude ilovasi shu papkaga nusxa qo`yadi)
Claude outputs/
# Agentlar orasidagi navbat almashish eslatmasi (faqat shu kompyuterda kerak)
HOLAT.md
# Sotib olingan SFX: do'kon litsenziyasi odatda qayta tarqatishni taqiqlaydi. Faqat assets/sfx/index.json
# va assets/sfx/_licenses/*.md gitda; audio va ularning yonidagi credit/LICENSE fayllari faqat shu kompyuterda.
assets/sfx/_inbox/
assets/sfx/_unsorted/
assets/sfx/**/real__*
brands/**/sfx/real__*
